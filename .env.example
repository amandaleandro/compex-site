DATABASE_URL="postgresql://compex:senha@localhost:55432/compex?schema=public"
PORT=3100

# Mercado Pago — Checkout Pro (loja) e Assinaturas (mensalidade)
# Gere em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
PUBLIC_BASE_URL=http://localhost:3100

# Evolution API — envio de WhatsApp (ver backend/lib/evolution.js). Sem essas três
# variáveis, o canal WhatsApp fica desligado (mensagens ficam registradas como FALHOU
# no histórico, mas nada quebra) — confira o status em /gestao/whatsapp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Token que a Evolution deve enviar no header X-Webhook-Token (ou ?token=) ao chamar
# /api/webhooks/evolution. Sem isso definido, o webhook aceita qualquer chamada.
EVOLUTION_WEBHOOK_TOKEN=
