{
  "name": "compex-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de gestão da Atlética Computação e Exatas",
  "scripts": {
    "start": "node backend/server.js",
    "db:generate": "prisma generate --config backend/prisma.config.ts",
