generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PRESIDENCIA
  FINANCEIRO
  ESPORTES
  EVENTOS
  MARKETING
  PRODUTOS
  PATRIMONIO
  ASSOCIADO
}

enum Status {
  ACTIVE
  PENDING
  EXPIRED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Rank {
  DIRETOR
  COORDENADOR
}

model User {
  id          String            @id @default(cuid())
  name        String
  email       String            @unique
  password    String
  role        Role              @default(ASSOCIADO)
  rank        Rank              @default(DIRETOR)
  permissions Json? // permissões extras concedidas além das padrão do Role (array de strings, ex: ["financeiro.aprovar"])
  active      Boolean           @default(true) // false = desligado da gestão; histórico é preservado, nunca apagado
  leftAt      DateTime?
  birthDate   DateTime?
  member      Member?
  warnings    DirectorWarning[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum WarningType {
  ADVERTENCIA
  SUSPENSAO
  DESLIGAMENTO
}

model DirectorWarning {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      WarningType
  reason    String
  createdAt DateTime    @default(now())
}

model Member {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String    @unique
  course         String
  plan           String
  planRef        Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId         String?
  sportSlots     Int       @default(1)
  membershipKind String    @default("SOCIO")
  status         Status    @default(PENDING)
  registration   String?   @unique
  cpf            String?   @unique
  socialName     String?
  nickname       String?
  sex            String?
  birthDate      DateTime?
  photoUrl       String?
  memberType     String    @default("TORCEDOR")
  selectedSports Json?
  shirtSize      String?
  instagram      String?
  phone          String?
  shift          String?
  preferences    Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  mpPayerId          String?   @unique
  mpPreapprovalId    String?   @unique
  subscriptionStatus String?
  currentPeriodEnd   DateTime?

  referralCode String?  @unique
  referredBy   Member?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredById String?
  referrals    Member[] @relation("Referrals")

  teamEnrollments    TeamEnrollment[]
  orders             Order[]
  pointsEntries      PointsEntry[]
  checkIns           EventCheckIn[]
  sessionCharges     SessionCharge[]
  sessionAttendances SessionAttendance[]
  trainingCheckIns   TrainingCheckIn[]
  socialSubmissions  SocialSubmission[]
}

enum Gender {
  MASCULINO
  FEMININO
  MISTA
}

enum TeamSessionType {
  TREINO
  JOGO
}

model Team {
  id               String           @id @default(cuid())
  name             String
  sport            String
  gender           Gender           @default(MISTA)
  description      String?
  trainingDay      String?
  active           Boolean          @default(true)
  dropInPriceCents Int?
  createdAt        DateTime         @default(now())
  enrollments      TeamEnrollment[]
  sessions         TeamSession[]
  coaches          Coach[]
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model TeamEnrollment {
  id        String           @id @default(cuid())
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  status    EnrollmentStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@unique([memberId, teamId])
}

model TeamSession {
  id            String              @id @default(cuid())
  team          Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  type          TeamSessionType
  date          DateTime
  location      String?
  coachName     String?
  coachCost     Decimal?            @db.Decimal(10, 2)
  refereeName   String?
  refereePixKey String?
  refereeCost   Decimal?            @db.Decimal(10, 2)
  notes         String?
  // Convocação de jogo só fica visível ao atleta quando published=true — permite à gestão
  // montar a lista de convocados antes de anunciar. Treinos continuam publicados por padrão.
  published     Boolean             @default(true)
  createdAt     DateTime            @default(now())
  charges       SessionCharge[]
  attendances   SessionAttendance[]
  checkIns      TrainingCheckIn[]
}

enum SessionChargeStatus {
  PENDING
  PAID
  FAILED
}

model SessionCharge {
  id          String              @id @default(cuid())
  session     TeamSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String
  amountCents Int
  breakdown   String?
  status      SessionChargeStatus @default(PENDING)
  mpPaymentId String?
  pixQrCode   String?
  pixQrBase64 String?
  createdAt   DateTime            @default(now())
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model SessionAttendance {
  id          String           @id @default(cuid())
  session     TeamSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String
  status      AttendanceStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([sessionId, memberId])
}

model TrainingCheckIn {
  id             String      @id @default(cuid())
  session        TeamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  member         Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       String
  checkedByEmail String
  checkedByName  String
  createdAt      DateTime    @default(now())

  @@unique([sessionId, memberId])
}

enum ProductType {
  PRONTA_ENTREGA
  ENCOMENDA
}

model Product {
  id                 String      @id @default(cuid())
  name               String
  description        String?
  imageUrl           String?
  priceCents         Int
  category           String
  stock              Int         @default(0)
  type               ProductType @default(PRONTA_ENTREGA)
  allowSize          Boolean     @default(false)
  allowCustomization Boolean     @default(false)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  orderItems         OrderItem[]
}

enum AssetCondition {
  OTIMO
  BOM
  REGULAR
  RUIM
}

enum LoanStatus {
  EMPRESTADO
  DEVOLVIDO
  ATRASADO
}

model AssetLoan {
  id               String     @id @default(cuid())
  asset            Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId          String
  borrowerName     String
  borrowerDocument String?
  borrowerPhone    String?
  quantity         Int        @default(1)
  loanDate         DateTime   @default(now())
  expectedReturn   DateTime?
  returnDate       DateTime?
  status           LoanStatus @default(EMPRESTADO)
  signatureData    String? // Guarda a assinatura digital em Base64 PNG ou Hash do aceite
  acceptedTerms    Boolean    @default(true)
  termDocumentUrl  String? // Caminho do comprovante/PDF/JSON em uploads/patrimonio
  notes            String?
  createdAt        DateTime   @default(now())
}

model Asset {
  id        String         @id @default(cuid())
  name      String
  category  String
  quantity  Int            @default(1)
  condition AssetCondition @default(BOM)
  sport     String?
  gender    Gender?
  location  String?
  notes     String?
  loans     AssetLoan[]
  createdAt DateTime       @default(now())
}

model Coach {
  id              String   @id @default(cuid())
  name            String
  hourlyRateCents Int
  pixKey          String?
  notes           String?
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId          String?
  createdAt       DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY_FOR_PICKUP
  DELIVERED
  CANCELED
}

model Order {
  id                String      @id @default(cuid())
  member            Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId          String
  status            OrderStatus @default(PENDING)
  totalCents        Int
  estimatedDelivery DateTime?
  notifiedAt        DateTime?
  deliveredAt       DateTime?
  deliveredBy       String?
  mpPreferenceId    String?     @unique
  mpPaymentId       String?
  createdAt         DateTime    @default(now())
  items             OrderItem[]
}

model OrderItem {
  id                  String  @id @default(cuid())
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId             String
  product             Product @relation(fields: [productId], references: [id])
  productId           String
  quantity            Int
  unitPriceCents      Int
  size                String?
  customizationName   String?
  customizationNumber String?
}

model Event {
  id                String   @id @default(cuid())
  name              String
  type              String
  date              DateTime
  time              String?
  location          String?
  description       String?
  platform          String   @default("BORAFEST")
  ticketUrl         String?
  boraFestUrl       String?
  published         Boolean  @default(false)
  isOwnOrganization Boolean  @default(true)
  revenue           Decimal? @default(0.00) @db.Decimal(12, 2)
  expenses          Decimal? @default(0.00) @db.Decimal(12, 2)
  financialNotes    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  checkIns EventCheckIn[]
}

enum TransactionStatus {
  PENDING
  PAID
}

model Transaction {
  id              String            @id @default(cuid())
  description     String
  amount          Decimal           @db.Decimal(12, 2)
  type            TransactionType
  category        String
  // PENDING = conta a pagar/receber ainda em aberto; PAID = já liquidada (comportamento
  // padrão anterior a este campo — por isso o default é PAID, para não alterar lançamentos existentes).
  status          TransactionStatus @default(PAID)
  dueDate         DateTime?
  favorecido      String?
  paymentMethod   String?
  responsibleName String?
  proofUrl        String?
  requestId       String? // vínculo com a Central de Solicitações, quando a movimentação nasceu de uma solicitação aprovada
  createdAt       DateTime          @default(now())
}

model News {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String
  imageUrl  String?
  videoUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Athlete {
  id         String   @id @default(cuid())
  name       String
  course     String
  sport      String
  position   String
  attendance Int      @default(0)
  createdAt  DateTime @default(now())
}

model Document {
  id           String   @id @default(cuid())
  name         String
  category     String
  url          String
  isPublic     Boolean  @default(false)
  // Vínculo opcional com o registro que originou o documento (ex: comprovante de uma Request),
  // pra aparecer tanto na Central de Documentos quanto na tela de origem.
  linkedEntity String?
  linkedId     String?
  createdAt    DateTime @default(now())
}

model Poll {
  id        String     @id @default(cuid())
  question  String
  options   Json
  closed    Boolean    @default(false)
  expiresAt DateTime?
  createdBy String?
  createdAt DateTime   @default(now())
  votes     PollVote[]
}

model PollVote {
  id          String   @id @default(cuid())
  poll        Poll     @relation(fields: [pollId], references: [id])
  pollId      String
  voterEmail  String
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([pollId, voterEmail])
}

enum BoardType {
  RECADO
  ELOGIO
}

model Task {
  id          String    @id @default(cuid())
  title       String
  team        String
  owner       String?
  assigner    String?
  priority    String    @default("media")
  dueDate     DateTime?
  completedAt DateTime?
  status      String    @default("todo")
  createdAt   DateTime  @default(now())
}

model Sponsor {
  id               String    @id @default(cuid())
  company          String
  contact          String
  value            String?
  status           String    @default("Negociando")
  delivery         String    @default("—")
  category         String    @default("PATROCINIO") // PATROCINIO ou PARCERIA
  responsibleName  String?
  responsibleEmail String?
  startDate        DateTime?
  endDate          DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
}

model BoardPost {
  id         String    @id @default(cuid())
  type       BoardType
  authorName String
  message    String
  createdAt  DateTime  @default(now())
}

enum PointsReason {
  MENSALIDADE_EM_DIA
  EVENTO_PRESENCA
  TREINO_INSCRICAO
  TREINO_PRESENCA
  COMPRA_LOJA
  ENGAJAMENTO_SOCIAL
  AJUSTE_ADMINISTRATIVO
}

model PointsEntry {
  id        String       @id @default(cuid())
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  reason    PointsReason
  points    Int
  note      String?
  createdAt DateTime     @default(now())
}

model EventCheckIn {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  createdAt DateTime @default(now())

  @@unique([eventId, memberId])
}

enum SocialSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Benefit {
  id          String   @id @default(cuid())
  name        String
  category    String
  discount    String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id             String   @id @default(cuid())
  name           String
  price          String // legado — mantido por compatibilidade; fonte de verdade para cobrança agora é priceCents
  priceCents     Int      @default(0)
  period         String   @default("/ano") // legado — texto exibido, ex. "/ano"
  periodicity    String   @default("ANUAL") // MENSAL | SEMESTRAL | ANUAL (livre, não travado em enum)
  durationMonths Int      @default(12)
  slots          Int      @default(1)
  icon           String?
  description    String?
  benefits       Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  members        Member[]
}

model SocialSubmission {
  id         String                 @id @default(cuid())
  member     Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   String
  link       String
  note       String?
  status     SocialSubmissionStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime               @default(now())
}

enum ChampionshipStatus {
  EM_ANDAMENTO
  FINALIZADO
  PROXIMO
}

model Championship {
  id        String             @id @default(cuid())
  name      String
  sport     String
  season    String?
  status    ChampionshipStatus @default(EM_ANDAMENTO)
  placement String?
  isTitle   Boolean            @default(false)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  games     ChampionshipGame[]
}

enum ChampionshipGameStatus {
  AGENDADO
  REALIZADO
}

model ChampionshipGame {
  id              String                 @id @default(cuid())
  championship    Championship           @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  championshipId  String
  opponentName    String
  opponentLogoUrl String?
  date            DateTime
  location        String?
  status          ChampionshipGameStatus @default(AGENDADO)
  ourScore        Int?
  opponentScore   Int?
  notes           String?
  createdAt       DateTime               @default(now())
}

// Toda ação administrativa relevante do sistema deve gerar um registro aqui —
// é a trilha de auditoria exigida para "quem solicitou → quem aprovou → quem executou".
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  actorRole  String?
  action     String // ex: "request.create", "request.approve", "request.reject", "transaction.create"
  entity     String // ex: "Request", "Transaction", "Member"
  entityId   String?
  before     Json?
  after      Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

enum RequestType {
  PAGAMENTO_TECNICO
  PAGAMENTO_ARBITRAGEM
  COMPRA_MATERIAIS
  FERRAMENTA_SOFTWARE
  CONTRATACAO_FORNECEDOR
  TRANSPORTE
  ALIMENTACAO
  INSCRICAO_CAMPEONATO
  REEMBOLSO
  EVENTO
  MATERIAL_ESPORTIVO
  DESPESA_ADMINISTRATIVA
  OUTRAS_DESPESAS
}

enum RequestPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum RequestStatus {
  RASCUNHO
  SOLICITADO
  APROVACAO_DIRETOR
  FINANCEIRO
  PRESIDENCIA
  APROVADO
  PAGO
  FINALIZADO
  REJEITADO
}

// Central de Solicitações — módulo genérico que substitui pedidos por WhatsApp/planilha
// por um fluxo único com histórico e aprovação, para qualquer tipo de pedido interno.
model Request {
  id             String          @id @default(cuid())
  type           RequestType
  requesterName  String
  requesterEmail String
  requesterRole  String
  department     String
  description    String
  justification  String?
  valuePlanned   Decimal?        @db.Decimal(12, 2)
  valueFinal     Decimal?        @db.Decimal(12, 2)
  favorecido     String?
  dueDate        DateTime?
  priority       RequestPriority @default(MEDIA)
  attachments    Json? // array de { name, url }
  observations   String?
  status         RequestStatus   @default(RASCUNHO)
  proofUrl       String? // comprovante de pagamento anexado
  rejectedReason String?
  // Fluxo de compras (tipos COMPRA_MATERIAIS, MATERIAL_ESPORTIVO, FERRAMENTA_SOFTWARE,
  // CONTRATACAO_FORNECEDOR): cotação de fornecedores, nota fiscal e confirmação de recebimento,
  // reaproveitando o mesmo fluxo de aprovação em vez de criar um módulo à parte.
  items                   Json? // array de { name, quantity, unit }
  quotations              Json? // array de { supplier, value, notes, addedBy, addedAt } — cotações registradas
  invoiceUrl              String? // nota fiscal
  purchaseResponsibleName String? // responsável pela compra
  receivedByName          String? // responsável pelo recebimento
  receivedAt              DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum DepartureStatus {
  SOLICITADO
  EM_ANALISE
  APROVADO
  REJEITADO
  FINALIZADO
}

// Solicitação formal de desligamento — substitui o "avisei no grupo que vou sair".
// Ao ser aprovada e finalizada, User.active vira false e User.leftAt é preenchido,
// mas o registro da solicitação (e o histórico do usuário) nunca é apagado.
model DepartureRequest {
  id             String          @id @default(cuid())
  requesterName  String
  requesterEmail String
  requesterRole  String
  department     String
  reason         String
  observations   String?
  attachments    Json?
  status         DepartureStatus @default(SOLICITADO)
  rejectedReason String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum RestStatus {
  SOLICITADO
  APROVADO
  REJEITADO
}

// Descanso da gestão — até 30 dias, uma vez por semestre (semester = "2026-1"/"2026-2").
model RestRequest {
  id              String     @id @default(cuid())
  requesterName   String
  requesterEmail  String
  requesterRole   String
  department      String
  startDate       DateTime
  endDate         DateTime
  days            Int
  semester        String
  reason          String?
  substituteName  String?
  status          RestStatus @default(SOLICITADO)
  rejectedReason  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum ScheduleFunction {
  SUMULA
  APOIO_JOGO
  BANDEIRAO
  MATERIAL
  TORCIDA
  FOTOGRAFIA
  SOCIAL_MEDIA
  EVENTOS
  BARRACAS
  RECEPCAO
  VENDA_INGRESSOS
  TRANSPORTE
  ORGANIZACAO
  OUTRA
}

enum ScheduleStatus {
  AGUARDANDO
  CONFIRMADO
  TROCA_SOLICITADA
  SUBSTITUIDO
  RECUSADO
  CONCLUIDO
}

// Escala genérica — cobre súmula, bandeirão, apoio de jogo, barracas, recepção etc.
// referenceLabel é livre (nome do jogo/evento) para não depender de vincular a um model específico.
model Schedule {
  id              String          @id @default(cuid())
  referenceLabel  String
  function        ScheduleFunction
  assignedName    String
  assignedEmail   String?
  date            DateTime
  time            String?
  location        String?
  instructions    String?
  status          ScheduleStatus  @default(AGUARDANDO)
  substituteName  String?
  createdByName   String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum DepartmentPlanStatus {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  ATRASADO
}

// Planejamento por departamento — objetivos/metas do semestre. O indicador de evolução
// (% concluído) é calculado a partir das Task do mesmo departamento, sem duplicar dado.
model DepartmentPlan {
  id            String               @id @default(cuid())
  department    String
  semester      String
  objective     String
  actions       Json? // array de { action, responsible, dueDate, done }
  responsible   String?
  dueDate       DateTime?
  status        DepartmentPlanStatus @default(PLANEJADO)
  createdByName String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// Notificação interna — evita depender de WhatsApp para avisar sobre aprovação,
// escala nova, prazo etc. Lida a partir do próprio sistema.
model Notification {
  id        String   @id @default(cuid())
  userEmail String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userEmail, read])
}

enum MeetingStatus {
  RASCUNHO
  FINALIZADA
}

// Reunião + ata em um único registro: enquanto RASCUNHO pode ser editada; ao virar
// FINALIZADA representa a ata oficial e nunca é apagada (histórico permanente).
model Meeting {
  id            String        @id @default(cuid())
  title         String
  type          String        @default("Ordinária")
  date          DateTime
  time          String?
  participants  Json? // array de nomes
  agenda        String?
  notes         String?
  decisions     Json? // array de { decision, responsible, dueDate }
  attachments   Json?
  status        MeetingStatus @default(RASCUNHO)
  createdByName String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
